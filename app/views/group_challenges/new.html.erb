<% content_for :title, "New challenge · MatheMinute" %>

<main class="page page--narrow">
  <h1 class="heading">New challenge</h1>
  <p class="aside">Everyone in <%= @group.name %> plays the same questions. Only their first saved score counts: each day's, if it's every day. Scores must be saved before the round ends.</p>

  <%= form_with model: @challenge, url: group_challenges_path(@group), scope: :group_challenge, class: "form" do |form| %>
    <%= render "errors", user: @challenge %>

    <div class="form__pair" data-controller="challenge-levels" data-challenge-levels-names-value="<%= challenge_level_names.to_json %>">
      <%= label_tag "group_challenge_topic", "Topic" %>
      <%= select_tag "group_challenge[topic]", options_for_select(Topic::ALL.map { [ "#{_1.emoji} #{_1.title}", _1.key ] }, @challenge.topic),
            id: "group_challenge_topic", class: "form__select", data: { action: "challenge-levels#update" } %>
      <%= label_tag "group_challenge_level", "Level" %>
      <%= select_tag "group_challenge[level]", challenge_level_options(@challenge.topic_module, @challenge.mixed? ? "mixed" : @challenge.level),
            id: "group_challenge_level", class: "form__select", data: { challenge_levels_target: "level" } %>
    </div>

    <fieldset class="choice">
      <legend>How often</legend>
      <% { "0" => "Just once: one set of questions", "1" => "Every day: new questions each day" }.each do |value, label| %>
        <label class="choice__option">
          <%= radio_button_tag "group_challenge[daily]", value, value == (@challenge.daily? ? "1" : "0") %>
          <span><%= label %></span>
        </label>
      <% end %>
    </fieldset>

    <fieldset class="choice">
      <legend>How long it runs</legend>
      <% Group::Challenge::DURATIONS.each_key.with_index do |label, i| %>
        <label class="choice__option">
          <%= radio_button_tag "group_challenge[duration]", label, i == 2 %>
          <span><%= label %></span>
        </label>
      <% end %>
    </fieldset>

    <label class="checkbox">
      <%= hidden_field_tag "group_challenge[owner_plays]", "0", id: nil %>
      <%= check_box_tag "group_challenge[owner_plays]", "1", @challenge.owner_plays %>
      I'm playing too
    </label>

    <%= form.submit "Set the challenge", class: "button button--go" %>
  <% end %>
</main>
