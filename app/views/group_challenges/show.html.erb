<% content_for :title, "#{@challenge.title} · #{@group.name} · MatheMinute" %>
<% entry = @leaderboard.find { _1.user == Current.user } %>
<% medal = ->(rank) { { 1 => "🥇", 2 => "🥈", 3 => "🥉" }.fetch(rank, rank) } %>

<main class="page challenge">
  <p class="label"><%= link_to @group.name, @group %></p>
  <h1 class="heading"><span aria-hidden="true"><%= @challenge.topic_module.emoji %></span> <%= @challenge.title %></h1>
  <p class="aside"><%= @challenge.topic_module.level(@challenge.level)[:name] %> · <%= challenge_status(@challenge) %></p>
  <%= render "flash" %>
  <p class="hint"><% if @challenge.open? %>
    Only your first saved score counts. Save before the challenge ends<%= " or midnight in #{@group.owner.time_zone}" if @challenge.daily? %>.
  <% else %>
    Only first scores saved before the round ended count.
  <% end %></p>
  <% if @challenge.daily? && !@challenge.open? && @round %>
    <p class="aside">Final day: <%= l(@round.day, format: :long) %> · Final week: <%= l(@challenge.leaderboard_week.first, format: :long) %></p>
  <% end %>

  <% if entry %>
    <p class="challenge__you">You scored <strong><%= entry.score %></strong><%= @challenge.open? ? " today" : " on the final day" if @challenge.daily? %>: <%= place(entry, @leaderboard) %></p>
  <% end %>

  <% if @challenge.playable_by?(Current.user) %>
    <%= link_to entry ? "Play again (just for practice)" : (@challenge.daily? ? "Play today's" : "Play"), play_path(@challenge.topic_module.slug, round: @round.id),
          class: ["button", "button--wide", entry ? "button--blue" : "button--start"] %>
  <% end %>

  <section class="leaderboard" aria-labelledby="leaderboard-heading">
    <h2 class="settings__heading" id="leaderboard-heading">Leaderboard</h2>

    <% if @challenge.daily? %>
      <%# Today's, or the week's by total (playing every day adds up) or best day (one great game) %>
      <nav class="board-switch" aria-label="Which leaderboard">
        <% { "today" => (@challenge.open? ? "Today" : "Final day"), "total" => (@challenge.open? ? "Week total" : "Final week"), "best" => "Best day" }.each do |board, label| %>
          <%= link_to label, group_challenge_path(@group, @challenge, board: (board unless board == "today")),
                class: "board-switch__option", aria: { current: (board == @board) } %>
        <% end %>
      </nav>
    <% end %>

    <% if @week_leaderboard %>
      <% if @week_leaderboard.any? %>
        <ol class="leaderboard__rows">
          <% @week_leaderboard.each do |row| %>
            <li class="leaderboard__row <%= "leaderboard__row--you" if row.user == Current.user %>">
              <span class="leaderboard__rank"><%= medal.(row.rank) %></span>
              <%= render "avatar", user: row.user, size: "small" %>
              <span class="leaderboard__name"><%= row.user.display_name %></span>
              <span class="leaderboard__score"><%= @board == "best" ? row.best : row.total %>
                <span class="leaderboard__wrong"><%= @board == "best" ? "total #{row.total}" : pluralize(row.days, "day") %></span></span>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="aside"><%= @challenge.open? ? "No one's played this week yet." : "No scores were saved in the final week." %></p>
      <% end %>
    <% elsif @leaderboard.any? %>
      <ol class="leaderboard__rows">
        <% @leaderboard.each do |row| %>
          <li class="leaderboard__row <%= "leaderboard__row--you" if row.user == Current.user %>">
            <span class="leaderboard__rank"><%= medal.(row.rank) %></span>
            <%= render "avatar", user: row.user, size: "small" %>
            <span class="leaderboard__name"><%= row.user.display_name %></span>
            <span class="leaderboard__score"><%= row.score %><% if row.wrong.positive? %> <span class="leaderboard__wrong"><%= row.wrong %> wrong</span><% end %></span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="aside"><%= @challenge.open? ? "No one's played #{@challenge.daily? ? "today" : "yet"}. Be the first!" : "No scores were saved for this round before it ended." %></p>
    <% end %>
  </section>

  <% if @group.owned_by?(Current.user) && @challenge.open? %>
    <%= button_to "Close the challenge", group_challenge_closing_path(@group, @challenge), class: "button button--wide", form_class: "wide-form",
          form: { data: { turbo_confirm: "Close this challenge? The leaderboard stays as it is now." } } %>
  <% end %>
</main>
