<% content_for :title, "Sign up · SUMZ" %>
<% content_for :no_auto_refresh, true %>

<main class="page page--narrow">
  <h1 class="heading">Make an account</h1>
  <% if @user.persisted? && @user.attempts.any? %>
    <p class="aside">Your streak and best score will be saved, and you can play on any device.</p>
  <% end %>
  <%= render "flash" %>

  <%= form_with model: @user, url: registration_path, method: :post, class: "form" do |form| %>
    <%= render "errors", user: @user %>

    <%= form.label :name, "What should we call you?" %>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "given-name", maxlength: 30 %>
    <p class="hint">Just your first name, or a nickname.</p>

    <%= form.label :username, "Pick a username" %>
    <%= form.text_field :username, required: true, autocomplete: "username", autocapitalize: "none", spellcheck: false, minlength: 3, maxlength: 20 %>
    <p class="hint">You'll use this to sign in. Don't use your real name.</p>

    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: User::MIN_PASSWORD_LENGTH, maxlength: 72 %>
    <p class="hint">Use at least <%= User::MIN_PASSWORD_LENGTH %> characters. A few words together work well.</p>

    <%= form.submit "Let's go!", class: "button button--go" %>
  <% end %>

  <p class="aside">Already have an account? <%= link_to "Sign in", new_session_path %></p>
</main>
