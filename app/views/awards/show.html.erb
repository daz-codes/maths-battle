<% content_for :title, "Awards · Maths Battle" %>

<main class="page">
  <h1 class="heading"><%= icon(:trophy) %> Awards</h1>
  <p class="aside"><%= @user.badges_by_kind.size %> of <%= Badge.catalogue.size %> unlocked</p>

  <% Badge::GROUPS.each do |group, heading| %>
    <section class="badges" aria-labelledby="badges-<%= group %>">
      <h2 class="settings__heading" id="badges-<%= group %>"><%= heading %></h2>
      <ul class="badges__list">
        <% Badge.in_group(group).each do |kind| %>
          <%= render "awards/badge", kind: kind, earned: @user.badges_by_kind[kind.key] %>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= link_to "Play", play_path, class: "button button--start button--wide" %>
</main>
