<% content_for :title, "#{@live ? "Battle" : "Solo"} · Maths Battle" %>
<% content_for :viewport, "width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" %>
<% content_for :body_class, "testing" %>
<% content_for :focus_mode, true %>

<main class="test<%= " test--live" if @live %>" data-controller="test"
      data-test-game-value="<%= @game.to_json %>"
      data-test-best-value="<%= @best %>"
      <% if @live %>data-test-live-value="<%= @live.to_json %>"<% end %>
      data-test-powers-value="<%= { every: PowerUp::EVERY, solo: PowerUp::SOLO, battle: PowerUp::BATTLE }.to_json %>"
      data-test-submit-url-value="<%= attempts_path %>">
  <button type="button" class="test__stop" data-action="test#confirmStop" aria-label="Stop the game">✕</button>

  <%# The score, how many are right and the streak (each right answer in a row scoring 10 more than the last), then
      the seconds left, counting down %>
  <header class="test__bar">
    <span class="test__tally">
      <span class="test__counts">
        <span class="test__count"><span class="test__score" data-test-target="score" aria-label="Score">0</span><span class="test__count-label">score</span></span>
        <span class="test__count"><span class="test__right" data-test-target="right" aria-label="Right">0</span><span class="test__count-label">right</span></span>
        <span class="test__count test__streak" data-test-target="streakCount">
          <span class="test__streak-number"><%= icon(:flame) %><span data-test-target="streak" aria-label="Right in a row">0</span></span>
          <span class="test__count-label">streak</span>
        </span>
      </span>
      <% if @best.positive? %><span class="test__best" data-test-target="best">Best <%= number_with_delimiter @best %></span><% end %>
    </span>
    <span class="test__timer"><span class="test__seconds" data-test-target="seconds" aria-label="Seconds left">60</span><span class="test__count-label">secs</span></span>
  </header>

  <%# A strip of its own, always the same height so the question never moves: every ten answers a power-up,
      flicking between what it could be until it's tapped %>
  <div class="test__powers">
    <button type="button" class="test__spinner" data-test-target="spinner" data-action="test#claim" aria-label="Tap to claim a power-up" hidden>
      <span class="test__spinner-icon" data-test-target="spinnerIcon"></span>
      <span class="test__spinner-label">Tap!</span>
    </button>
  </div>
  <% power_up_icons.each do |kind, icon_name| %>
    <template data-test-target="powerIcon" data-power-up="<%= kind %>"><%= icon(icon_name) %></template>
  <% end %>
  <template data-test-target="trophyIcon"><%= icon(:trophy) %></template>

  <%# A battle: everyone else's score as they play %>
  <% if @live %>
    <div class="test__live">
      <ol class="test__rivals" aria-label="Other players">
        <% @live[:rivals].each do |rival| %>
          <li class="test__rival" data-test-target="rival" data-player-id="<%= rival[:id] %>" data-name="<%= rival[:name] %>"><%= rival[:name] %> <strong>0</strong></li>
        <% end %>
      </ol>
    </div>
  <% end %>

  <div class="test__stage" data-test-target="stage">
    <%# What a power-up did, over the top of the question so it takes no room of its own %>
    <p class="test__power-news" data-test-target="powerNews" aria-live="polite"></p>
    <p class="question question--current" data-test-target="question" aria-live="off">Ready</p>
    <p class="answer" data-test-target="answer" aria-live="polite"></p>
    <p class="test__status" data-test-target="status" hidden></p>
  </div>

  <%= render "keypad", keys: [ "." ] %>

  <%# Someone's Ink blot: blots that run down the whole screen, covering different parts as they go %>
  <% if @live %>
    <div class="test__ink" aria-hidden="true"><% 5.times do %><span class="test__blot"></span><% end %></div>
  <% end %>

  <dialog class="dialog" data-test-target="stopDialog" data-action="cancel->test#keepPlaying">
    <h2 class="dialog__title">Stop this game?</h2>
    <p class="dialog__text"><%= @live ? "Your answers won't be saved, and the battle carries on without you." : "Your answers won't be saved." %></p>
    <div class="dialog__actions">
      <button type="button" class="button button--blue" data-action="test#keepPlaying" autofocus>Keep playing</button>
      <button type="button" class="button" data-action="test#stopGame">Stop game</button>
    </div>
  </dialog>
</main>
