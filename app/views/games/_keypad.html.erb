<%# Digits, delete, and any extra keys the level needs: / for fractions, . for decimals, − for negatives.
    With two extra keys it goes to four columns, so it still fits small phones.
    controller: the one the keys tap, the game's (test) or a tutorial's %>
<% controller = local_assigns.fetch(:controller, "test") %>
<div class="keypad <%= "keypad--wide" if keys.many? %>" <%= tag.attributes("data-#{controller}-target": "keypad") %>>
  <% if keys.many? %>
    <% %w[1 2 3].each do |digit| %><%= keypad_key digit, controller: controller %><% end %>
    <%= delete_key controller: controller %>
    <% %w[4 5 6].each do |digit| %><%= keypad_key digit, controller: controller %><% end %>
    <%= extra_keypad_key keys.first, controller: controller %>
    <% %w[7 8 9].each do |digit| %><%= keypad_key digit, controller: controller %><% end %>
    <%= extra_keypad_key keys.second, controller: controller %>
    <%= keypad_key "0", modifier: "zero", controller: controller %>
  <% else %>
    <% %w[1 2 3 4 5 6 7 8 9].each do |digit| %><%= keypad_key digit, controller: controller %><% end %>
    <%= keys.one? ? extra_keypad_key(keys.first, controller: controller) : tag.span %>
    <%= keypad_key "0", controller: controller %>
    <%= delete_key controller: controller %>
  <% end %>
</div>
