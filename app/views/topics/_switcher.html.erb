<%# Chooses what Play plays, and which topic the home page's numbers are for. Remembered on this device %>
<nav class="switcher" aria-label="Topic">
  <% Topic::ALL.each do |topic| %>
    <%= button_to topic_path, method: :patch, params: { topic: topic::SLUG },
          class: "switcher__option", form_class: "switcher__form",
          aria: { current: (topic == current_topic) } do %>
      <span aria-hidden="true"><%= topic::EMOJI %></span> <%= topic::NAME %>
    <% end %>
  <% end %>
</nav>
