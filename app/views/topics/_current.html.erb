<%# The topic the player is on, like a language in Duolingo, as a title with a link under it to change it: it
    goes to the page for changing it. from: the page to come back to after changing, or nil for home %>
<div class="current-topic">
  <p class="current-topic__name"><%= topic_icon(topic) %> <%= topic.title %></p>
  <%= link_to "Change topic", topics_path(from: from), class: "current-topic__change", aria: { label: "#{topic.title}. Change topic" } %>
</div>
