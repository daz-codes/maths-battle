<%# Once a day: the button to play it, or how it went %>
<% if (done = user.daily_challenge_on(topic)) %>
  <%= link_to attempt_path(done), class: "button button--start button--done" do %>
    ✅ Done today: <%= done.score %>
  <% end %>
<% else %>
  <%= link_to "⭐ Daily challenge", play_path(topic.slug, challenge: 1), class: "button button--start" %>
<% end %>
