<%# One of the topic's unlocked levels, the same on every page that needs it. choosing: :play on the home page
    (changes what its Play button, above, plays), or :stats on the stats page, which has its own Play button under
    the levels. Then mixed practice, once there's more than one level to mix, and reviewing mistakes %>
<div class="levels-panel">
<% if topic.levels.many? %>
  <% unlocked = user.unlocked_level(topic) %>
  <nav class="levels" aria-label="Level" data-controller="keep-scroll" data-action="submit->keep-scroll#remember">
    <% topic.levels.each do |details| %>
      <% if details[:number] <= unlocked %>
        <% url, options = level_choice(choosing, topic, details[:number]) %>
        <%= button_to url, **options, class: "levels__level", form_class: "levels__form",
              title: "Level #{details[:number]}: #{details[:name]}", aria: { current: (details[:number] == level) } do %>
          <%= details[:number] %>
          <% if (medal = user.medal(topic, details[:number])) %>
            <span class="levels__medal" aria-label="<%= Attempt::MEDAL_NAMES[medal] %>"><%= Attempt::MEDAL_EMOJI[medal] %></span>
          <% end %>
        <% end %>
      <% else %>
        <span class="levels__level levels__level--locked" title="Level <%= details[:number] %>: <%= details[:name] %> (locked)">
          <%= render "icons/lock" %>
        </span>
      <% end %>
    <% end %>
  </nav>
  <p class="levels__name">Level <%= level %>: <%= topic.level(level)[:name] %></p>
  <p class="levels__medal-line"><%= medal_progress(user, topic, level) %></p>
  <% if topic.lesson(level) %>
    <p class="levels__learn"><%= link_to "📖 Learn how", lesson_path(topic.slug, level) %></p>
  <% end %>
<% end %>
<%= link_to "Play level #{level}", play_path(topic.slug, level: level), class: "button button--blue button--practise" if choosing == :stats %>
<%= link_to "🔀 Mixed practice", play_path(topic.slug, mixed: 1), class: "button button--mixed" if user.unlocked_level(topic) > 1 %>
<% if (review = user.review_questions(topic)).any? %>
  <%= link_to "🔁 Review mistakes (#{review.size})", play_path(topic.slug, review: 1), class: "button button--review" %>
<% end %>
</div>
