<%# Picks a topic and one of its unlocked levels, the same on every page that needs it.
    choosing: :play on the home page (changes what Play plays), or :stats on the stats page.
    Topics are a dropdown, so there's room for as many as there are. Play goes under the levels, as wide
    as they are: on the home page it plays the current level, on the stats page the level being looked at %>
<% url, method = topic_choice(choosing) %>
<%= form_with url: url, method: method, class: "topic-picker", data: { controller: "auto-submit" } do |form| %>
  <%= form.label :topic, "Topic", class: "visually-hidden" %>
  <span class="topic-picker__field">
    <%= form.select :topic, Topic::ALL.map { |choice| [ "#{choice.emoji} #{choice.title}", choice.slug ] }, { selected: topic.slug },
          class: "topic-picker__select", data: { action: "auto-submit#submit" } %>
  </span>
  <noscript><%= form.submit "Go", class: "button" %></noscript>
<% end %>

<div class="levels-panel">
<% if topic.levels.many? %>
  <% unlocked = user.unlocked_level(topic) %>
  <nav class="levels" aria-label="Level">
    <% topic.levels.each do |details| %>
      <% if details[:number] <= unlocked %>
        <% url, options = level_choice(choosing, topic, details[:number]) %>
        <%= button_to url, **options, class: "levels__level", form_class: "levels__form",
              title: "Level #{details[:number]}: #{details[:name]}", aria: { current: (details[:number] == level) } do %>
          <%= details[:number] %>
        <% end %>
      <% else %>
        <span class="levels__level levels__level--locked" title="Level <%= details[:number] %>: <%= details[:name] %> (locked)">
          <%= render "icons/lock" %>
        </span>
      <% end %>
    <% end %>
  </nav>
  <p class="levels__name">Level <%= level %>: <%= topic.level(level)[:name] %></p>
  <% if topic.lesson(level) %>
    <p class="levels__learn"><%= link_to "📖 Learn how", lesson_path(topic.slug, level) %></p>
  <% end %>
<% end %>
<%= link_to "Play", play_path(topic.slug, level: (level if choosing == :stats)), class: "button button--start" %>
</div>
