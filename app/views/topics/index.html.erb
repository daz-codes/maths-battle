<% content_for :title, "Topics · MatheMinute" %>

<main class="page">
  <h1 class="heading">Topics</h1>
  <p class="aside">Pick what to practise. Your progress in each is kept.</p>

  <ul class="topic-cards">
    <% Topic::ALL.each do |topic| %>
      <% current = topic == current_topic %>
      <li>
        <%= button_to topic_path, method: :patch, params: { topic: topic.slug, from: params[:from] }.compact,
              class: [ "topic-card", ("topic-card--current" if current) ], form_class: "topic-card__form", aria: { current: current } do %>
          <span class="topic-card__emoji" aria-hidden="true"><%= topic.emoji %></span>
          <span class="topic-card__body">
            <span class="topic-card__title"><%= topic.title %><%= tag.span(" · On it now", class: "topic-card__now") if current %></span>
            <span class="topic-card__level">Level <%= @user.unlocked_level(topic) %> of <%= topic.max_level %></span>
            <span class="topic-card__medals" aria-label="Medals">
              <% topic.levels.each do |level| %>
                <% medal = @user.medal(topic, level[:number]) %>
                <% if level[:number] > @user.unlocked_level(topic) %>
                  <span class="topic-card__medal topic-card__medal--locked" title="Level <%= level[:number] %>: locked"><%= render "icons/lock" %></span>
                <% else %>
                  <span class="topic-card__medal" title="Level <%= level[:number] %>: <%= medal ? Attempt::MEDAL_NAMES[medal] : "no medal yet" %>"><%= medal ? Attempt::MEDAL_EMOJI[medal] : "◌" %></span>
                <% end %>
              <% end %>
            </span>
            <%= tag.span("✅ Challenge done today", class: "topic-card__done") if @user.daily_challenge_on(topic) %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</main>
