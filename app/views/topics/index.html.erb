<% content_for :title, "Topics · MatheMinute" %>

<main class="page">
  <% if topic_chosen? %>
    <h1 class="heading">Topics</h1>
    <p class="aside">Pick what to practise. Your progress in each is kept.</p>
  <% else %>
    <h1 class="heading">What do you want to practise?</h1>
    <p class="aside">Pick a topic to start. You can change it any time.</p>
  <% end %>

  <ul class="topic-cards">
    <% Topic::ALL.each do |topic| %>
      <% current = topic_chosen? && topic == current_topic %>
      <li>
        <%= button_to topic_path, method: :patch, params: { topic: topic.slug, from: params[:from] }.compact,
              class: [ "topic-card", ("topic-card--current" if current) ], form_class: "topic-card__form", aria: { current: current } do %>
          <span class="topic-card__icon"><%= topic_icon(topic) %></span>
          <span class="topic-card__body">
            <span class="topic-card__title"><%= topic.title %><%= tag.span(" · On it now", class: "topic-card__now") if current %></span>
            <span class="topic-card__level">Level <%= @user.unlocked_level(topic) %> of <%= topic.max_level %></span>
            <%# Each level: its number in a circle, its stars under it, or a padlock until it's unlocked %>
            <span class="topic-card__levels" aria-label="Stars for each level">
              <% topic.levels.each do |level| %>
                <% locked = level[:number] > @user.unlocked_level(topic) %>
                <span class="topic-card__step <%= "topic-card__step--locked" if locked %>" title="Level <%= level[:number] %><%= ": locked" if locked %>">
                  <span class="topic-card__number"><%= locked ? icon(:lock) : level[:number] %></span>
                  <%= star_rating(@user.stars(topic, level[:number])) unless locked %>
                </span>
              <% end %>
            </span>
            <%= tag.span(safe_join([ icon(:check), " Played today" ]), class: "topic-card__done") if @user.played_today?(topic) %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</main>
