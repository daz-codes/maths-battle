<!DOCTYPE html>
<html lang="<%= language %>" data-theme="<%= colour_preference %>" data-sounds="<%= current_player.sounds? ? "on" : "off" %>">
  <head>
    <title><%= content_for(:title) || "Maths Battle" %></title>
    <meta name="viewport" content="<%= content_for(:viewport) || "width=device-width,initial-scale=1" %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Maths Battle">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="application-name" content="Maths Battle">
    <meta name="mobile-web-app-capable" content="yes">
    <% %w[ light dark ].each do |scheme| %>
      <meta name="theme-color" content="<%= theme_colour(scheme) %>" media="(prefers-color-scheme: <%= scheme %>)"
            data-theme-color="<%= scheme %>" data-color="<%= ApplicationHelper::THEME_COLOURS.fetch(scheme) %>">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="player-key" content="<%= player_key %>">
    <meta name="player-version" content="<%= player_identity_version %>">
    <meta name="turbo-cache-control" content="no-cache">

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="<%= icon_path "favicon.ico" %>" sizes="48x48">
    <link rel="icon" href="<%= icon_path "favicon.svg" %>" type="image/svg+xml">
    <link rel="icon" href="<%= icon_path "favicon-96x96.png" %>" type="image/png" sizes="96x96">
    <link rel="apple-touch-icon" href="<%= icon_path "apple-touch-icon.png" %>" sizes="180x180">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Lexend:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= ["app-shell", content_for(:body_class)].compact.join(" ") %>" <%= tag.attributes(data: { controller: "theme", theme_preference_value: colour_preference }) %>>
    <%= render "header" unless content_for?(:focus_mode) %>
    <%= yield %>
    <%= render "footer" unless content_for?(:focus_mode) %>
  </body>
</html>
