<!DOCTYPE html>
<html lang="<%= language %>" data-theme="<%= current_player.theme %>">
  <head>
    <title><%= content_for(:title) || "MatheMinute" %></title>
    <meta name="viewport" content="<%= content_for(:viewport) || "width=device-width,initial-scale=1" %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="MatheMinute">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="application-name" content="MatheMinute">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#fffef9" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#181a32" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="player-key" content="<%= player_key %>">
    <meta name="player-version" content="<%= player_identity_version %>">
    <meta name="turbo-cache-control" content="no-cache">

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="<%= icon_path "favicon.ico" %>" sizes="48x48">
    <link rel="icon" href="<%= icon_path "favicon.svg" %>" type="image/svg+xml">
    <link rel="icon" href="<%= icon_path "favicon-96x96.png" %>" type="image/png" sizes="96x96">
    <link rel="apple-touch-icon" href="<%= icon_path "apple-touch-icon.png" %>" sizes="180x180">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400..900;1,500..700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class) %>"
        <%= tag.attributes(data: { controller: "sync", sync_upload_url_value: attempts_path, sync_auto_refresh_value: !content_for?(:no_auto_refresh) }) unless content_for?(:focus_mode) %>>
    <%# The logo is the way home from every page, except mid-test where nothing should distract %>
    <% unless content_for?(:focus_mode) %>
      <header class="site-header">
        <%= render "logo" %>
        <%= tag.p(yield(:tagline), class: "tagline") if content_for?(:tagline) %>
      </header>
      <p class="flash flash--alert refused-games" role="alert" data-sync-target="refused" hidden></p>
    <% end %>
    <%= yield %>
    <%= render "footer" unless content_for?(:focus_mode) %>
  </body>
</html>
