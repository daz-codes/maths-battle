<% content_for :title, "Your stats · MatheMinute" %>

<main class="page">
  <h1 class="heading">Your stats</h1>

  <%= render "topics/chooser", choosing: :stats, user: @user, topic: @topic, level: @level %>

  <% if @user.tracked?(@topic, @level) %>
    <% if (best = @user.best_group(@topic, @level)) %>
      <% needs = @user.group_needing_practice(@topic, @level) %>
      <p class="summary">
        <%= sanitize @topic.summary(best: tag.strong(best.label), needs: (tag.strong(needs.label) if needs)), tags: %w[ strong ] %>
      </p>
    <% end %>

    <% overall = @user.overall_stats(@topic, @level) %>
    <dl class="stats stats--three">
      <div><dt>Accuracy</dt><dd><%= percent(overall.percent) %></dd></div>
      <div><dt>Average</dt><dd><%= seconds(overall.average_ms) %></dd></div>
      <div><dt>Games</dt><dd><%= @user.games_played(@topic, @level) %></dd></div>
    </dl>

    <table class="tables">
      <caption class="label">Each <%= @topic.group_heading.downcase %></caption>
      <thead>
        <tr>
          <th scope="col"><%= @topic.group_heading %></th>
          <th scope="col"><span class="visually-hidden">Bar</span></th>
          <th scope="col">Accuracy</th>
          <th scope="col">Speed</th>
        </tr>
      </thead>
      <tbody>
        <% @user.group_stats(@topic, @level).each do |row| %>
          <tr title="<%= row.label %>: <%= row.answered.positive? ? "#{row.right} of #{row.answered} right, average #{seconds(row.average_ms)}" : "not asked yet" %>">
            <th scope="row">
              <%= row.label %>
              <% if (example = @topic.group_example(row.group)) %><span class="tables__example">e.g. <%= example %></span><% end %>
            </th>
            <td class="tables__bar">
              <span class="bar"><span class="bar__fill" style="width: <%= row.percent || 0 %>%"></span></span>
            </td>
            <td><%= percent(row.percent) %></td>
            <td><%= seconds(row.average_ms) %><%= tag.span(" 🐢", title: "Slower than usual") if row.slow? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <p class="hint hint--centre">
      Speed is the average time for a right answer.
      <% if @user.group_stats(@topic, @level).any?(&:slow?) %>🐢 means slower than your usual.<% end %>
    </p>
  <% else %>
    <p class="aside">Play a game of <%= @topic::NAME.downcase %> and your stats will show up here.</p>
  <% end %>

  <%= link_to "Play", play_path(@topic::SLUG, level: @level), class: "button button--blue button--wide" %>
</main>
