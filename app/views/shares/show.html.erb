<% content_for :title, @share_text.title %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="MatheMinute">
  <meta property="og:title" content="<%= @share_text.title %>">
  <meta property="og:description" content="A MatheMinute player got <%= @attempt.score %> times tables right in 60 seconds. Can you beat it?">
  <meta property="og:url" content="<%= share_url(@attempt.share_token) %>">
  <meta name="twitter:card" content="summary">
<% end %>

<main class="page results">
  <%= render "logo" %>
  <p class="label">A MatheMinute player got</p>

  <%= render "attempts/card", attempt: @attempt %>

  <p class="feedback">Can you beat it?</p>

  <%= link_to "Try MatheMinute!", root_path, class: "button button--cta button--wide" %>
</main>
