<% content_for :title, @attempt.share_title %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="MatheMinute">
  <meta property="og:title" content="<%= @attempt.share_title %>">
  <meta property="og:description" content="<%= @attempt.share_description %>">
  <meta property="og:url" content="<%= share_url(@attempt.share_token) %>">
  <meta name="twitter:card" content="summary">
<% end %>

<main class="page results">
  <p class="label">A MatheMinute player got</p>

  <%= render "attempts/card", attempt: @attempt %>
  <%= render "badges/earned", badges: @attempt.badges %>

  <p class="feedback">Can you beat it?</p>

  <%= link_to "Try MatheMinute!", root_path, class: "button button--cta button--wide" %>
</main>
