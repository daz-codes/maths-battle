<%# The badges one game earned, on its results page and its share page. Badges never name the player. On the
    results page (reveal) each spins to the front of the screen, then back to its place (reveal controller) %>
<% if badges.any? %>
  <section class="badges badges--new" <%= tag.attributes(data: { controller: ("confetti" if local_assigns[:celebrate]) }) %>>
    <h2 class="label"><%= badges.one? ? "New award!" : "New awards!" %></h2>
    <ul class="badges__list">
      <% badges.each do |badge| %>
        <li class="badge" <%= tag.attributes(data: { reveal_target: ("item" if local_assigns[:reveal]) }) %>>
          <span class="badge__icon"><%= icon(badge.icon) %></span>
          <span class="badge__name"><%= badge.name %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
