<% content_for :title, "#{@head_to_head.challenger.display_name} challenged you · MatheMinute" %>

<main class="page page--narrow head-to-head-link">
  <%= render "flash" %>
  <h1 class="heading"><%= icon(:versus) %> <%= @head_to_head.challenger.display_name %> challenged you!</h1>
  <p class="aside"><%= topic_icon(@head_to_head.topic_module) %> <%= @head_to_head.title %></p>

  <% if @head_to_head.link? && @head_to_head.open? %>
    <p class="head-to-head-link__target">Beat <strong><%= @head_to_head.challenger_attempt.score %></strong> in a minute</p>
    <p class="hint hint--centre">Same questions, one go each. <%= time_left(@head_to_head).capitalize %>.</p>
    <%= form_with url: head_to_head_link_path(@head_to_head.share_token), class: "form" do %>
      <% if @user.name.blank? && @user.guest? %>
        <%= label_tag :name, "What should we call you?" %>
        <%= text_field_tag :name, nil, autocomplete: "given-name", maxlength: User::NAME_LENGTH, required: true %>
        <p class="hint"><%= @head_to_head.challenger.display_name %> sees it with your score. A first name is plenty.</p>
      <% end %>
      <%= submit_tag "Play", class: "button button--start button--wide", name: nil %>
    <% end %>
  <% else %>
    <p class="aside"><%= @head_to_head.link? ? "This challenge has run out." : "Someone else has already taken up this challenge." %></p>
    <%= link_to "Play MatheMinute", root_path, class: "button button--blue button--wide" %>
  <% end %>
</main>
