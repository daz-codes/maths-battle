<% content_for :title, "Your next minute · MatheMinute" %>
<% daily_tests = DailyTest.on(@user.today) %>
<% completed = daily_tests.count { |test| @user.daily_game(test) } %>
<% all_done = completed == daily_tests.size %>

<main class="page home ui-home">
  <%= render "flash" %>

  <div class="ui-welcome">
    <div>
      <p class="ui-eyebrow"><%= @user.display_name ? "Hi #{@user.display_name}! Ready for another round?" : "Your next personal best starts here" %></p>
      <h1 class="ui-home__heading">
        One minute.<br><span>All in.</span>
      </h1>
    </div>
    <div class="streak ui-streak" aria-label="<%= @user.streak %> day streak">
      <%= icon(:flame) %><strong><%= @user.streak %></strong><span>day streak</span>
    </div>
  </div>

  <nav class="home-actions ui-actions" aria-label="Play">
    <%= link_to challenge_path, class: "button home-action home-action--challenge ui-daily" do %>
      <span class="ui-daily__info">
        <span class="ui-eyebrow"><span class="ui-live-dot" aria-hidden="true"></span> Today's main event</span>
        <span class="home-action__label">Daily Challenge</span>
        <span class="ui-daily__description">Pick a daily game. Same questions.<br>See how you stack up.</span>
        <span class="ui-daily__meta"><span>60 seconds</span><span>One go per game</span></span>
        <span class="ui-daily__cta"><%= all_done ? "See your results" : "Let's play" %> <span aria-hidden="true">↗</span></span>
        <span class="ui-daily__edition"><%= completed.positive? ? "#{completed} of #{daily_tests.size} done today" : daily_tests.map(&:name).join(" · ") %> · <%= @user.today.strftime("%a, %-d %b") %></span>
      </span>
      <%= render "home/daily_art" %>
    <% end %>

    <%= link_to practice_path, class: "button home-action home-action--practice ui-secondary" do %>
      <span class="ui-secondary__top"><span class="ui-secondary__icon"><%= icon(:lightning) %></span><span class="ui-secondary__arrow" aria-hidden="true">↗</span></span>
      <span class="home-action__label">Practice</span>
      <span class="ui-secondary__description"><%= Topic::ALL.size %> topics. Your pace.<br>Keep chasing your best.</span>
    <% end %>
    <%= link_to groups_path, class: "button home-action home-action--compete ui-secondary" do %>
      <span class="ui-secondary__top"><span class="ui-secondary__icon"><%= icon(:people) %></span><span class="ui-secondary__arrow" aria-hidden="true">↗</span></span>
      <span class="home-action__label">Compete</span>
      <span class="ui-secondary__description">Bring your friends.<br>Give them a score to beat.</span>
    <% end %>
  </nav>

  <%= render "head_to_heads/to_play", user: @user %>
  <%= render "groups/to_play", user: @user %>

  <section class="ui-progress" aria-labelledby="ui-progress-heading">
    <div class="ui-section-heading"><h2 id="ui-progress-heading">Your personal scoreboard</h2><%= link_to "All stats ↗", stats_path %></div>
    <dl class="stats">
      <div><dt>Personal best</dt><dd><%= @user.persisted? ? number_with_delimiter(@user.best_score) : "—" %><span class="ui-stat-caption">A score worth chasing</span></dd></div>
      <div><dt>Longest streak</dt><dd><%= @user.persisted? ? @user.longest_streak : 0 %><span class="ui-stat-unit"> <%= "day".pluralize(@user.longest_streak) %></span><span class="ui-stat-caption">Little by little, every day</span></dd></div>
    </dl>
  </section>

  <p class="ui-home__footnote">A minute to play. A reason to come back.</p>
  <% if @user.guest? %>
    <p class="save-nudge">No account needed to play. <%= link_to "Save your progress", new_registration_path %> to keep your scores across devices.</p>
  <% end %>
  <%= render "install" %>
</main>
