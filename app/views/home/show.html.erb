<% content_for :title, "Your next minute · MatheMinute" %>
<% content_for :under_logo do %>
  <h1 class="ui-home__heading">Master <%= maths.capitalize %> in <span>Minutes</span></h1>
<% end %>
<% content_for :beside_hello do %>
  <span class="streak ui-streak <%= "streak--done" if @user.practised_today? %>" aria-label="<%= @user.streak %> day streak"
        title="<%= @user.streak %> day streak"><%= icon(:flame) %><strong><%= @user.streak %></strong></span>
<% end %>

<main class="page home ui-home">
  <%= render "flash" %>

  <nav class="home-actions ui-actions" aria-label="Play">
    <div class="home-action home-action--challenge ui-daily">
      <div class="ui-daily__info">
        <p class="ui-eyebrow"><span class="ui-live-dot" aria-hidden="true"></span> <%= @user.today.strftime("%A %-d %B") %></p>
        <h2 class="home-action__label">Daily Challenges</h2>
        <div class="ui-daily__games">
          <% DailyTest.on(@user.today).each do |daily_test| %>
            <%= render "home/daily_game", daily_test: daily_test, attempt: @user.daily_game(daily_test) %>
          <% end %>
        </div>
      </div>
      <%= render "home/daily_art" %>
    </div>

    <%= link_to practice_path, class: "button home-action home-action--practice ui-secondary" do %>
      <span class="ui-secondary__top"><span class="ui-secondary__icon"><%= icon(:lightning) %></span><span class="ui-secondary__arrow" aria-hidden="true">↗</span></span>
      <span class="home-action__label">Practice</span>
      <span class="ui-secondary__description"><%= Topic::ALL.size %> topics. Your pace.<br>Keep chasing your best.</span>
    <% end %>
    <%= link_to groups_path, class: "button home-action home-action--compete ui-secondary" do %>
      <span class="ui-secondary__top"><span class="ui-secondary__icon"><%= icon(:people) %></span><span class="ui-secondary__arrow" aria-hidden="true">↗</span></span>
      <span class="home-action__label">Compete</span>
      <span class="ui-secondary__description">Bring your friends.<br>Give them a score to beat.</span>
    <% end %>
  </nav>

  <%= render "head_to_heads/to_play", user: @user %>
  <%= render "groups/to_play", user: @user %>

  <section class="ui-progress" aria-labelledby="ui-progress-heading">
    <div class="ui-section-heading"><h2 id="ui-progress-heading">Your personal scoreboard</h2><%= link_to "All stats ↗", stats_path %></div>
    <dl class="stats">
      <div><dt>High score</dt><dd><%= icon(:trophy) %> <%= @user.persisted? ? number_with_delimiter(@user.best_score) : "—" %></dd></div>
      <div><dt>Longest streak</dt><dd><%= icon(:flame) %> <%= @user.persisted? ? @user.longest_streak : 0 %><span class="ui-stat-unit"> <%= "day".pluralize(@user.longest_streak) %></span></dd></div>
    </dl>
  </section>

  <% if @user.guest? %>
    <p class="save-nudge">No account needed to play. <%= link_to "Save your progress", new_registration_path %> to keep your scores across devices.</p>
  <% end %>
  <%= render "install" %>
</main>
