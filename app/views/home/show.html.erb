<% content_for :title, "Maths Battle" %>
<% content_for :under_logo do %>
  <h1 class="ui-home__heading">One minute. <span>Every answer counts.</span></h1>
<% end %>

<main class="page home ui-home">
  <%= render "flash" %>

  <nav class="home-actions ui-actions home-actions--modes" aria-label="Play">
    <%# Each on one line: its icon, then what it is %>
    <%= link_to play_path, class: "button home-action home-action--solo ui-secondary" do %>
      <span class="ui-secondary__icon"><%= icon(:solo) %></span>
      <span class="home-action__label">Single player</span>
    <% end %>
    <%= link_to multiplayer_path, class: "button home-action home-action--battle ui-secondary" do %>
      <span class="ui-secondary__icon"><%= icon(:versus) %></span>
      <span class="home-action__label">Multiplayer</span>
    <% end %>
  </nav>

  <%# Four boxes: where they are in today's world league, then their records, each from one game %>
  <dl class="stats stats--home">
    <%= link_to leagues_path, class: "stats__tile stats__tile--league" do %>
      <dt><%= icon(:trophy) %> World league</dt>
      <dd><% if @standing %><%= @standing.rank.ordinalize %><span class="stats__unit"> of <%= number_with_delimiter @world.size %></span><% else %>—<% end %></dd>
    <% end %>
    <div class="stats__tile"><dt><%= icon(:star) %> Highest score</dt><dd><%= number_with_delimiter(@user.persisted? ? @user.best_score : 0) %></dd></div>
    <div class="stats__tile"><dt><%= icon(:flame) %> Longest streak</dt><dd><%= @user.persisted? ? @user.longest_streak : 0 %></dd></div>
    <div class="stats__tile"><dt><%= icon(:target) %> Most right</dt><dd><%= @user.persisted? ? @user.most_correct : 0 %></dd></div>
  </dl>
  <% if @user.persisted? && !@user.named? %>
    <p class="hint"><%= link_to "Give yourself a name", edit_profile_path %> to appear in the leagues.</p>
  <% end %>

  <% if @user.guest? %>
    <p class="save-nudge">No account needed to play. <%= link_to "Make an account", new_registration_path %> to keep your scores and leagues on every device.</p>
  <% end %>
  <%= render "install" %>
  <p class="how-link"><%= link_to "How it works", how_it_works_path %></p>
</main>
