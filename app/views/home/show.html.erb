<% content_for :tagline, "Improve your #{maths} in minutes" %>

<main class="page home">
  <%= render "flash" %>

  <%# The greeting, with the streak small beside it %>
  <div class="greeting">
    <% if @user.display_name %>
      <%= link_to edit_profile_path, class: "greeting__avatar", aria: { label: "Settings" } do %>
        <%= render "avatar", user: @user, size: "greeting" %>
      <% end %>
      <h1 class="greeting__hello">Hi <%= @user.display_name %>!</h1>
    <% end %>
    <span class="streak <%= "streak--done" if @user.practised_today? %>" aria-label="<%= @user.streak %> day streak"
          title="<%= @user.streak %> day streak"><%= icon(:flame, class: "streak__flame") %><%= @user.streak %></span>
  </div>

  <nav class="home-actions" aria-label="Play">
    <%= link_to challenge_path, class: "button button--wide home-action home-action--challenge" do %>
      <span class="home-action__label"><%= icon(:target) %> Daily Challenge</span>
      <% done = DailyTest.on(@user.today).count { @user.daily_game(_1) } %>
      <span class="button__note"><%= { 0 => DailyTest::KINDS.values.map { _1[:name] }.join(" · "), DailyTest::KINDS.size => "All done for today" }.fetch(done) { "#{done} of #{DailyTest::KINDS.size} done today" } %></span>
    <% end %>
    <%= link_to practice_path, class: "button button--wide home-action home-action--practice" do %>
      <span class="home-action__label"><%= icon(:lightning) %> Practice</span>
    <% end %>
    <%= link_to groups_path, class: "button button--wide home-action home-action--compete" do %>
      <span class="home-action__label"><%= icon(:people) %> Compete</span>
    <% end %>
  </nav>

  <%= render "head_to_heads/to_play", user: @user %>
  <%= render "groups/to_play", user: @user %>

  <%# The bests across every game: the best score from one, and the longest streak %>
  <% if @user.persisted? %>
    <dl class="stats">
      <div><dt>Best score</dt><dd><%= icon(:trophy) %> <%= number_with_delimiter @user.best_score %></dd></div>
      <div><dt>Longest streak</dt><dd><%= icon(:flame) %> <%= @user.longest_streak %></dd></div>
    </dl>
  <% end %>

  <% if @user.guest? && @user.persisted? %>
    <p class="save-nudge">
      Your streak is only saved on this device.
      <%= link_to "Make an account", new_registration_path %> to keep it safe.
    </p>
  <% end %>

  <%= render "install" %>
</main>
