<% content_for :tagline, "Improve your #{maths} in minutes" %>

<main class="page home">
  <%= render "flash" %>

  <%= render "topics/current", topic: current_topic, from: nil %>

  <% if @user.display_name %>
    <h1 class="greeting">
      <%= link_to edit_profile_path, class: "greeting__avatar", aria: { label: "Settings" } do %>
        <%= render "avatar", user: @user, size: "greeting" %>
      <% end %>
      Hi <%= @user.display_name %>!
    </h1>
  <% end %>

  <section class="streak <%= "streak--done" if @user.practised_today? %>" aria-label="Streak">
    <span class="streak__number"><%= icon(:flame, class: "streak__flame") %><%= @user.streak %></span>
    <span class="streak__label">day streak</span>
  </section>

  <%= render "topics/play", user: @user, topic: current_topic, level: current_level %>
  <%= render "head_to_heads/to_play", user: @user %>
  <%= render "groups/to_play", user: @user %>

  <%= render "topics/chooser", choosing: :play, user: current_player, topic: current_topic, level: current_level %>

  <% if @user.persisted? %>
    <dl class="stats">
      <div><dt>Best</dt><dd><%= icon(:trophy) %> <%= @user.best_score(current_topic, current_level) %></dd></div>
      <div><dt>Longest streak</dt><dd><%= @user.longest_streak %></dd></div>
      <div><dt>Average score</dt><dd><%= @user.average_score(current_topic, current_level) || "—" %></dd></div>
      <div><dt>Average time</dt><dd><%= seconds(@user.overall_stats(current_topic, current_level).average_ms) %></dd></div>
    </dl>
    <%= link_to "See all stats", stats_path(current_topic.slug) %>
  <% end %>

  <% if @user.guest? && @user.persisted? %>
    <p class="save-nudge">
      Your streak is only saved on this device.
      <%= link_to "Make an account", new_registration_path %> to keep it safe.
    </p>
  <% end %>

  <%= render "install" %>
</main>
