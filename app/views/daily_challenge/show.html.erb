<% content_for :title, "Daily Challenge · MatheMinute" %>

<main class="page daily-challenge">
  <%= link_to "← Home", root_path, class: "back-link" %>
  <h1 class="heading"><%= icon(:target) %> Daily Challenge</h1>
  <p class="aside"><%= @daily_tests.first.day.strftime("%-d %B %Y") %></p>
  <%= render "flash" %>

  <% @daily_tests.each do |daily_test| %>
    <%= render "daily_challenge/test", daily_test: daily_test, user: @user %>
  <% end %>
</main>
