<%# The topic's levels: unlocked ones can be picked (Play remembers it), locked ones show what's coming %>
<% if current_topic.levels.many? %>
  <nav class="levels" aria-label="Level">
    <% unlocked = current_player.unlocked_level(current_topic) %>
    <% current_topic.levels.each do |level| %>
      <% if level[:number] <= unlocked %>
        <%= button_to level_path, method: :patch, params: { level: level[:number] },
              class: "levels__level", form_class: "levels__form", title: "Level #{level[:number]}: #{level[:name]}",
              aria: { current: (level[:number] == current_level) } do %>
          <%= level[:number] %>
        <% end %>
      <% else %>
        <span class="levels__level levels__level--locked" title="Level <%= level[:number] %>: <%= level[:name] %> (locked)">🔒</span>
      <% end %>
    <% end %>
  </nav>
  <p class="levels__name">Level <%= current_level %>: <%= Topic.level(current_topic, current_level)[:name] %></p>
<% end %>
