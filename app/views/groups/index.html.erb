<% content_for :title, "Compete · MatheMinute" %>

<main class="page groups">
  <%= link_to "← Home", root_path, class: "back-link" %>
  <h1 class="heading">Compete</h1>
  <%= render "flash" %>

  <section class="head-to-heads" aria-labelledby="head-to-heads-heading">
    <h2 class="settings__heading" id="head-to-heads-heading">Head to head</h2>
    <% if @head_to_heads.any? %>
      <ul class="challenge-cards">
        <%= render partial: "head_to_heads/card", collection: @head_to_heads, as: :head_to_head, locals: { user: @user } %>
      </ul>
    <% else %>
      <p class="aside">No head to heads yet.</p>
    <% end %>
  </section>

  <section class="live-start" aria-labelledby="live-heading">
    <h2 class="settings__heading" id="live-heading">Live</h2>
    <%= button_to safe_join([ icon(:lightning), " Play Live" ]), live_games_path, class: "button button--start button--wide", form_class: "wide-form" %>
    <%= form_with url: live_games_path, method: :get, class: "group-join__form" do %>
      <label class="visually-hidden" for="live_code">Live game code</label>
      <%= text_field_tag :code, nil, id: "live_code", placeholder: "Got a code? Like K7Q2M", autocomplete: "off", autocapitalize: "characters", maxlength: 12, class: "group-join__code" %>
      <%= submit_tag "Join game", class: "button button--blue", name: nil %>
    <% end %>
  </section>

  <section class="group-list" aria-labelledby="groups-heading">
    <h2 class="settings__heading" id="groups-heading">Groups</h2>
    <% if @groups.any? %>
      <ul class="group-cards">
        <% @groups.each do |group| %>
          <% waiting = @waiting_counts.fetch(group.id, 0) %>
          <li>
            <%= link_to group, class: "group-card" do %>
              <span class="group-card__name"><%= group.name %></span>
              <span class="group-card__about">
                <%= pluralize(@member_counts.fetch(group.id, 0), "player") %><%= " · You run it" if group.owned_by?(@user) %>
              </span>
              <%= tag.span(safe_join([ icon(:trophy), " #{pluralize(waiting, "challenge")} to play" ]), class: "group-card__waiting") if waiting.positive? %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="aside">No groups yet.</p>
    <% end %>
  </section>

  <section class="group-join" aria-labelledby="join-heading">
    <h2 class="settings__heading" id="join-heading">Join a group</h2>
    <%= form_with url: join_group_path, method: :get, class: "group-join__form" do %>
      <label class="visually-hidden" for="code">Group code</label>
      <%= text_field_tag :code, nil, placeholder: "Code, like K7Q2MX", autocomplete: "off", autocapitalize: "characters", maxlength: 12, class: "group-join__code" %>
      <%= submit_tag "Join group", class: "button button--blue", name: nil %>
    <% end %>
  </section>

  <% if @user.can_make_groups? %>
    <%= link_to safe_join([ icon(:people), " Create a Group" ]), new_group_path, class: "button button--go button--wide" %>
  <% else %>
    <p class="aside"><%= link_to "Make an account", new_registration_path %> to start a group of your own.</p>
  <% end %>
</main>
