<% content_for :title, "#{@group.name} · MatheMinute" %>
<% owner = @group.owned_by?(Current.user) %>

<main class="page group">
  <%= link_to "← All groups", groups_path, class: "back-link" %>
  <h1 class="heading"><%= @group.name %></h1>
  <%= render "flash" %>
  <p class="aside">👥 <%= pluralize(@memberships.size, "player") %><%= " · run by #{@group.owner.display_name}" unless owner %></p>

  <% if owner %>
    <section class="group-code" aria-label="How others join">
      <p class="group-code__label">Share this code so others can join</p>
      <p class="group-code__code"><%= @group.join_code %></p>
      <button type="button" class="button" data-controller="share"
              data-share-text-value="Join <%= @group.name %> on MatheMinute: <%= join_group_url(@group.join_code) %>" data-action="share#share">Share the link</button>
      <%= button_to "New invite code", group_invite_code_path(@group), class: "link-button",
            form: { data: { turbo_confirm: "Replace this invite code? Old codes and links will stop working. Existing players stay joined." } } %>
      <p class="hint">Removed someone by mistake? Share the current code to invite them back.</p>
    </section>
  <% end %>

  <section class="challenges" aria-labelledby="challenges-heading">
    <h2 class="settings__heading" id="challenges-heading">Challenges</h2>
    <% if @challenge_cards.any? %>
      <ul class="challenge-cards">
        <% @challenge_cards.each do |card| %>
          <%= render "group_challenges/card", group: @group, card: card %>
        <% end %>
      </ul>
    <% else %>
      <p class="aside"><%= owner ? "Set a challenge for everyone to play." : "No challenges yet. #{@group.owner.display_name} will set one." %></p>
    <% end %>
    <%= link_to "+ New challenge", new_group_challenge_path(@group), class: "button button--go button--wide" if owner %>
  </section>

  <details class="group-members">
    <summary>Players</summary>
    <ul>
      <% @memberships.each do |membership| %>
        <li class="group-members__player">
          <%= render "avatar", user: membership.user, size: "small" %>
          <span class="group-members__name"><%= membership.user.display_name %><%= " (runs the group)" if @group.owned_by?(membership.user) %></span>
          <% if owner && !@group.owned_by?(membership.user) %>
            <%= button_to "Remove", group_membership_path(@group, membership), method: :delete, class: "button group-members__remove",
                  form: { data: { turbo_confirm: "Remove #{membership.user.display_name} from #{@group.name}? The invite code will change. You can invite them back with the new code." } } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </details>

  <% if owner %>
    <%= button_to "Delete this group", group_path(@group), method: :delete, class: "button button--wide", form_class: "wide-form",
          form: { data: { turbo_confirm: "Delete #{@group.name} and all its challenges? This can't be undone." } } %>
  <% else %>
    <%= button_to "Leave this group", group_membership_path(@group, @memberships.find { |membership| membership.user_id == Current.user.id }), method: :delete,
          class: "button button--wide", form_class: "wide-form", form: { data: { turbo_confirm: "Leave #{@group.name}?" } } %>
  <% end %>
</main>
