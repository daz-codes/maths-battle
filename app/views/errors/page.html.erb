<%# A static error page, written into public/ by bin/rails errors:pages so it still shows when the app can't:
    the app's header and logo, what happened, and a way home. Styles are inline, as the app's stylesheet has a
    fingerprinted name that changes with each deploy %>
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · SUMZ</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Monoton&family=Lexend:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root { --yellow: #ff7900; --green: #2858e8; --pink: #ff7900; --blue: #2858e8; --ink: #fffbe8; --muted: #596a80; --paper: #24365c; --paper-alt: #fff; --accent: #fdfc52; --on-accent: #fff; color-scheme: light; }
    @media (prefers-color-scheme: dark) {
      :root { --yellow: #ff6fcf; --green: #4aa3ff; --pink: #ff6fcf; --blue: #4aa3ff; --ink: #fffbe8; --muted: #afb5cc; --paper: #24365c; --paper-alt: #1b1e2c; --accent: #fdfc52; --on-accent: #1b2a4a; color-scheme: dark; }
    }
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; min-height: 100dvh; background: var(--paper); color: var(--ink); text-align: center;
      font-family: "Lexend", ui-sans-serif, system-ui, sans-serif; }
    .site-header { display: flex; flex-direction: column; align-items: center; padding: calc(1.5rem + env(safe-area-inset-top)) 1rem 0; }
    .logo { display: inline-flex; align-items: center; gap: 0.65rem; color: var(--ink); text-decoration: none; font-size: 24px; font-weight: 800; letter-spacing: -1.5px; }
    .clock { display: block; color: var(--ink); overflow: visible; }
    .logo__mark { width: 32px; height: 32px; }
    .logo__minute { font-weight: 500; }
    main { display: flex; flex-direction: column; align-items: center; gap: 1rem; max-width: 26rem; margin: 0 auto; padding: 3rem 1rem; }
    .error__icon { margin: 0; color: var(--accent); }
    .error__icon svg { width: 4rem; height: 4rem; }
    h1 { margin: 0; font-size: clamp(1.9rem, 8vw, 2.4rem); font-weight: 800; letter-spacing: -0.03em; }
    p { margin: 0; color: var(--muted); font-size: 1.1rem; font-weight: 600; }
    .button { display: inline-flex; align-items: center; justify-content: center; min-height: 3.25rem; margin-top: 0.5rem; padding: 0.6rem 1.6rem;
      border-radius: 12px; background: var(--accent);
      color: var(--on-accent); font-size: 1rem; font-weight: 800; text-decoration: none; }
    :focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
    .error__code { color: var(--muted); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.1em; }
  </style>
</head>
<body>
  <header class="site-header">
    <a class="logo" aria-label="SUMZ home" href="/">
      <%= render "clock", class: "logo__mark" %>
      <span>SUM<span class="logo__minute">Z</span></span>
    </a>
  </header>
  <main>
    <p class="error__icon"><%= icon(local_assigns[:icon]) %></p>
    <h1><%= title %></h1>
    <p><%= message %></p>
    <a class="button" href="/">Back to home</a>
    <p class="error__code">Error <%= code %></p>
  </main>
</body>
</html>
