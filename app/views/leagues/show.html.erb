<% content_for :title, "#{@league.name} · SUMZ" %>
<% owner = @league.owned_by?(Current.user) %>

<main class="page group">
  <%= link_to "← Leagues", leagues_path, class: "back-link" %>
  <h1 class="heading"><%= @league.name %></h1>
  <%= render "flash" %>
  <p class="aside"><%= icon(:people) %> <%= pluralize(@memberships.size, "player") %><%= " · run by #{@league.owner.display_name}" unless owner %></p>

  <section class="league" aria-labelledby="table-heading">
    <h2 class="settings__heading" id="table-heading">Today</h2>
    <%= render "leagues/table", standings: @standings, user: Current.user %>
    <% if @yesterday %>
      <p class="hint hint--centre"><%= icon(:trophy) %> Yesterday's champion: <strong><%= @yesterday.user.display_name %></strong> with <%= number_with_delimiter @yesterday.score %></p>
    <% end %>
    <%= link_to "Play now", play_path, class: "button button--start button--wide" %>
  </section>

  <% if owner %>
    <section class="group-code" aria-label="How others join">
      <p class="group-code__label">Share this code so others can join</p>
      <p class="group-code__code"><%= @league.join_code %></p>
      <button type="button" class="button" data-controller="share"
              data-share-text-value="Join <%= @league.name %> on SUMZ: <%= join_league_url(@league.join_code) %>" data-action="share#share">Share the link</button>
      <%= button_to "New invite code", league_invite_code_path(@league), class: "link-button",
            form: { data: { turbo_confirm: "Replace this invite code? Old codes and links will stop working. Existing players stay in." } } %>
      <p class="hint">Removed someone by mistake? Share the current code to invite them back.</p>
    </section>
  <% end %>

  <details class="group-members">
    <summary>Players</summary>
    <ul>
      <% @memberships.each do |membership| %>
        <li class="group-members__player">
          <%= render "avatar", user: membership.user, size: "small" %>
          <span class="group-members__name"><%= membership.user.display_name %><%= " (runs the league)" if @league.owned_by?(membership.user) %></span>
          <% if owner && !@league.owned_by?(membership.user) %>
            <%= button_to "Remove", league_membership_path(@league, membership), method: :delete, class: "button group-members__remove",
                  form: { data: { turbo_confirm: "Remove #{membership.user.display_name} from #{@league.name}? The invite code will change. You can invite them back with the new code." } } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </details>

  <% if owner %>
    <%= button_to "Delete this league", league_path(@league), method: :delete, class: "button button--wide", form_class: "wide-form",
          form: { data: { turbo_confirm: "Delete #{@league.name}? This can't be undone." } } %>
  <% else %>
    <%= button_to "Leave this league", league_membership_path(@league, @memberships.find { |membership| membership.user_id == Current.user.id }), method: :delete,
          class: "button button--wide", form_class: "wide-form", form: { data: { turbo_confirm: "Leave #{@league.name}?" } } %>
  <% end %>
</main>
