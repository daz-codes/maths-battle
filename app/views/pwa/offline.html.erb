<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Offline · Maths Battle</title>
  <style>
    :root { --paper: #fff4e2; --ink: #1d1440; --muted: #596a80; --accent: #ff5a1f; --on-accent: #fff; color-scheme: light; }
    @media (prefers-color-scheme: dark) {
      :root { --paper: #150d33; --ink: #fff3e0; --muted: #afb5cc; --accent: #ff6a2b; --on-accent: #14191a; color-scheme: dark; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100dvh; display: grid; place-content: center; gap: 1rem; padding: 1.5rem;
      font-family: "Lexend", ui-sans-serif, system-ui, sans-serif; text-align: center; background: var(--paper); color: var(--ink); }
    .logo { margin-bottom: 1.5rem; font-size: 24px; font-weight: 800; letter-spacing: -1.5px; }
    .logo__minute { font-weight: 500; }
    h1 { margin: 0; font-size: 2.25rem; font-weight: 800; letter-spacing: -0.045em; }
    p { max-width: 22rem; justify-self: center; margin: 0; font-size: 1rem; line-height: 1.6; color: var(--muted); }
    button { min-height: 50px; padding: 0.6rem 1.4rem; border: 0; border-radius: 12px;
      background: var(--accent); color: var(--on-accent); font: inherit; font-weight: 800; cursor: pointer; }
    :focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  </style>
</head>
<body>
  <div class="logo">Maths<span class="logo__minute">Battle</span></div>
  <h1>You're offline</h1>
  <p>Connect to the internet to load this page. Maths Battle needs a connection for its leagues and battles.</p>
  <form action="" method="get" aria-label="Retry loading this page">
    <button type="submit">Try again</button>
  </form>
</body>
</html>
