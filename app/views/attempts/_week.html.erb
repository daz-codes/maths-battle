<%# A daily challenge's last seven days for this player, a column a day by score, this game's in the accent. Shown
    once there's more than one game to compare. This game's score and the week's best are labelled; the others say
    theirs on a hover or tap, and to screen readers %>
<% games = week.filter_map(&:attempt) %>
<% if games.size > 1 %>
  <% top = games.map(&:score).max %>
  <% best = games.max_by(&:score) %>
  <% today = attempt.user.today %>
  <figure class="week-chart">
    <figcaption class="week-chart__title">Your <%= attempt.daily_test.name %> this week</figcaption>
    <ol class="week-chart__days">
      <% week.each do |day| %>
        <% game = day.attempt %>
        <% name = day.day == today ? "Today" : day.day.strftime("%a") %>
        <% about = game ? "#{number_with_delimiter game.score}, #{game.correct} right" : "not played" %>
        <%= tag.li class: [ "week-chart__day", ("week-chart__day--this" if game == attempt), ("week-chart__day--missed" unless game) ],
              tabindex: (0 if game), aria: { label: "#{day.day.strftime("%A %-d %B")}: #{about}" } do %>
          <span class="week-chart__plot" aria-hidden="true">
            <% if game %>
              <span class="week-chart__value <%= "week-chart__value--shown" if game == attempt || game == best %>"><%= number_with_delimiter game.score %></span>
              <span class="week-chart__bar" style="--share: <%= top.positive? ? (game.score.to_f / top).round(3) : 0 %>"></span>
            <% end %>
          </span>
          <span class="week-chart__label" aria-hidden="true"><%= name %></span>
        <% end %>
      <% end %>
    </ol>
  </figure>
<% end %>
