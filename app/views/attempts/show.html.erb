<% content_for :title, "#{@attempt.review? ? "#{@attempt.score} of #{@attempt.answered} right" : "#{@attempt.score} in a minute!"} · MatheMinute" %>

<main class="page results">
  <% if @attempt.levelled_up %>
    <p class="banner banner--level" data-controller="confetti fanfare">⬆️ Level up! You've unlocked Level <%= @attempt.level + 1 %>: <%= @attempt.topic_module.level(@attempt.level + 1)[:name] %></p>
    <%= link_to "📖 Learn how to do level #{@attempt.level + 1}", lesson_path(@attempt.topic_module.slug, @attempt.level + 1), class: "button button--blue" if @attempt.topic_module.lesson(@attempt.level + 1) %>
  <% elsif (medal = @attempt.new_medal) %>
    <p class="banner banner--medal" data-controller="confetti"><%= Attempt::MEDAL_EMOJI[medal] %> <%= Attempt::MEDAL_NAMES[medal] %> medal for level <%= @attempt.level %>!</p>
  <% elsif @attempt.new_high_score %>
    <p class="banner" data-controller="confetti">🎉 New high score! 🎉</p>
  <% end %>

  <%= render "card", attempt: @attempt %>

  <% if @attempt.earned_streak_freeze %>
    <p class="freeze-earned">🧊 <%= @attempt.streak %> day streak! You earned a free streak freeze.</p>
  <% end %>

  <section class="stars-earned" aria-label="Stars">
    <span class="stars-earned__total">+<%= number_with_delimiter @attempt.stars %> ⭐</span>
    <% if @attempt.star_bonuses.any? %>
      <ul class="stars-earned__bonuses">
        <% @attempt.star_bonuses.each do |bonus, stars| %>
          <li><%= Attempt::BONUS_NAMES[bonus] %> +<%= stars %></li>
        <% end %>
      </ul>
    <% end %>
  </section>
  <%= render "badges/earned", badges: @attempt.badges, celebrate: !(@attempt.levelled_up || @attempt.new_high_score) %>

  <% if @attempt.review? %>
    <%# Nothing to share without a clock: on to the mistakes still left, or back to practice %>
    <% topic = @attempt.topic_module %>
    <div class="results__actions results__actions--one">
      <% if (left = @attempt.user.review_questions(topic)).any? %>
        <%= link_to "🔁 Review #{left.size} more", play_path(topic.slug, review: 1), class: "button button--blue" %>
      <% else %>
        <%= link_to "Practise level #{@attempt.user.unlocked_level(topic)}", play_path(topic.slug, level: @attempt.user.unlocked_level(topic)), class: "button button--blue" %>
      <% end %>
    </div>
  <% else %>
  <div class="results__actions">
    <button type="button" class="button button--share" data-controller="share"
            data-share-text-value="<%= @attempt.share_text(share_url(@attempt.share_token)) %>" data-action="share#share">Share</button>
    <% if @attempt.daily_challenge? %>
      <%= link_to "Practise level #{@attempt.level}", play_path(@attempt.topic_module.slug, level: @attempt.level), class: "button button--blue" %>
    <% else %>
      <%= link_to "Play again", play_path(@attempt.topic_module.slug, level: @attempt.level), class: "button button--blue" %>
    <% end %>
  </div>
  <% end %>

  <p class="feedback"><%= @attempt.feedback_message %></p>

  <% if @attempt.missed_facts.any? || @attempt.slow_facts.any? %>
    <section class="missed">
      <h2 class="label">Work on these</h2>
      <ul>
        <% @attempt.missed_facts.each do |fact| %>
          <li><%= fact %></li>
        <% end %>
        <% @attempt.slow_facts.each do |fact| %>
          <li class="missed__slow"><%= fact %> <span title="Right, but slow">🐢</span></li>
        <% end %>
      </ul>
      <% if @attempt.slow_facts.any? %>
        <p class="hint hint--centre">🐢 Right, but slow. Practise these to get quicker.</p>
      <% end %>
    </section>
  <% end %>

  <%= tag.p(medal_progress(@attempt.user, @attempt.topic_module, @attempt.level), class: "level-progress") if @attempt.practice? %>
  <%= link_to "See your stats", stats_path(@attempt.topic_module.slug) %>
  <%= link_to "See your achievements", achievements_path if @attempt.badges.any? %>

  <% if @attempt.user.guest? %>
    <p class="save-nudge">
      <%= link_to "Make an account", new_registration_path %> to keep your streak safe and play on any device.
    </p>
  <% end %>
</main>
