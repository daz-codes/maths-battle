<% content_for :title, "Scored #{number_with_delimiter @attempt.score}! · SUMZ" %>
<% world = @world.entry_for(@attempt.user) %>
<% best_today = world && world.score == @attempt.score %>

<main class="page results" data-controller="reveal" data-celebration-id="attempt-<%= @attempt.id %>">
  <%= link_to "← #{@attempt.battle? ? "Multiplayer" : "Home"}", @attempt.battle? ? multiplayer_path : root_path, class: "back-link" %>
  <% if @attempt.new_best %>
    <p class="banner" data-reveal-target="item" data-controller="confetti fanfare" data-confetti-big-value="true"><%= icon(:party) %> New personal best!</p>
  <% end %>

  <section class="result">
    <p class="label"><%= @attempt.battle? ? "Battle" : "Solo" %> · <%= l(@attempt.played_at, format: :short) %></p>
    <p class="result__score"><span class="card__number"><%= number_with_delimiter @attempt.score %></span> <span class="result__right"><%= pluralize(@attempt.correct, "right answer") %></span></p>
    <p class="result__stats"><%= icon(:flame) %> Best streak <%= @attempt.best_streak %></p>
  </section>

  <%# Straight into another go: the biggest thing on the page after the score %>
  <%= link_to safe_join([ icon(:lightning), " Play again" ]), play_path, class: "button button--start button--wide button--again" unless @live_game %>

  <%= render "awards/earned", badges: @attempt.badges %>

  <% if @attempt.powers.any? %>
    <ul class="score-tally" aria-label="Power-ups">
      <% @attempt.powers.group_by { |power| power["kind"] }.each do |kind, powers| %>
        <li><%= icon(power_up_icons.fetch(kind)) %> <%= PowerUp::ALL.dig(kind, :name) %><%= " ×#{powers.size}" if powers.many? %><%= " (hit you)" if kind == "reset" %></li>
      <% end %>
    </ul>
  <% end %>

  <% if @live_game %>
    <%# Where they came, and everyone's places as their games come in %>
    <%= turbo_stream_from @live_game %>
    <% place = @live_game.place_of(@attempt.user) %>
    <p class="banner banner--group" <%= "data-controller=confetti" if place&.rank == 1 %>><%= icon(:versus) %> <%= place&.rank ? "You came #{place.rank.ordinalize}!" : "Your game's saved" %></p>
    <%= render "live_games/podium", live_game: @live_game %>
    <%= render "live_games/again", live_game: @live_game, user: @attempt.user %>
  <% end %>

  <%# Today's leagues, for a solo game: where it puts them, if it's their best today. Battles don't count in them %>
  <% if @attempt.solo? %>
    <section class="league" aria-labelledby="league-heading">
      <h2 class="settings__heading" id="league-heading">Today's leagues</h2>
      <ul class="league-places">
        <li><%= icon(:trophy) %> World league: <% if world && @attempt.user.named? %><strong><%= world.rank.ordinalize %></strong> of <%= number_with_delimiter @world.size %><%= best_today ? "" : " (best today #{number_with_delimiter world.score})" %><% else %><%= link_to "give yourself a name", edit_profile_path %> to appear<% end %></li>
        <% @leagues.each do |league| %>
          <% entry = league.standings(@attempt.played_on).entry_for(@attempt.user) %>
          <li><%= icon(:people) %> <%= link_to league.name, league %>: <strong><%= entry&.rank&.ordinalize || "—" %></strong> of <%= league.standings(@attempt.played_on).size %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <div class="results__actions results__actions--one">
    <%= link_to "See the leagues", leagues_path, class: "button button--blue" %>
  </div>
</main>
