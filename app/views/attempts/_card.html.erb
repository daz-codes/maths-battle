<%# The result as shared: score, streak and best. Nothing about who the player is %>
<section class="card">
  <p class="card__score"><span class="card__number"><%= attempt.score %></span> in a minute!</p>
  <p class="card__stats">🔥 <%= attempt.streak %> day streak · 🏆 Best: <%= attempt.user.high_score %></p>
</section>
