<%# The result as shared: the score inside the logo's ring of four neon quarters, then streak and best.
    Nothing about who the player is %>
<section class="result">
  <p class="label"><%= attempt.topic_module::EMOJI %> <%= attempt.topic_module::NAME %></p>
  <div class="result__ring">
    <%= render "clock", hands: false, class: "result__clock" %>
    <p class="result__score"><span class="card__number"><%= attempt.score %></span> in a minute!</p>
  </div>
  <p class="result__stats">🔥 <%= attempt.streak %> day streak · 🏆 Best: <%= attempt.user.best_score(attempt.topic_module) %></p>
</section>
