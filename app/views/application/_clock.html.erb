<%# A clock face ringed by a minute in four neon quarters. As the test timer, the quarters fill in
    one by one while a single hand goes round once in the minute (both driven by the test controller).
    Without hands it's just the ring.
    Each quarter is a full 90°, and the ring is cut by a thin plus sign, so every quarter ends square:
    straight across, horizontal or vertical. Each clock has its own cut, as a page can have two %>
<% timer = local_assigns.fetch(:timer, false) %>
<% hands = local_assigns.fetch(:hands, true) %>
<% quarters = %w[ yellow green blue pink ] %>
<% gaps = "clock-gaps-#{SecureRandom.hex(4)}" %>
<svg class="clock <%= local_assigns[:class] %>" viewBox="0 0 48 48" aria-hidden="true">
  <defs>
    <mask id="<%= gaps %>" maskUnits="userSpaceOnUse" x="0" y="0" width="48" height="48">
      <rect width="48" height="48" fill="white"/>
      <rect x="22.75" width="2.5" height="48" fill="black"/>
      <rect y="22.75" width="48" height="2.5" fill="black"/>
    </mask>
  </defs>
  <g transform="rotate(-90 24 24)" fill="none" stroke-width="6" mask="url(#<%= gaps %>)">
    <% quarters.each_with_index do |colour, i| %>
      <% if timer %>
        <circle class="clock__track" cx="24" cy="24" r="20" pathLength="100" stroke="var(--<%= colour %>)" stroke-dasharray="25 75" stroke-dashoffset="<%= -25 * i %>"/>
      <% end %>
      <circle cx="24" cy="24" r="20" pathLength="100" stroke="var(--<%= colour %>)"
              stroke-dasharray="<%= timer ? "0 100" : "25 75" %>" stroke-dashoffset="<%= -25 * i %>"
              <%= tag.attributes(data: { test_target: ("quarter" if timer) }) %> />
    <% end %>
  </g>
  <% if timer %>
    <%# Starts at 12; the test controller turns it about the centre as the seconds go %>
    <line class="clock__hand" x1="24" y1="24" x2="24" y2="9.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"
          data-test-target="hand"/>
    <circle cx="24" cy="24" r="2.4" fill="currentColor"/>
  <% elsif hands %>
    <%# The logo's hands, which stay still %>
    <g stroke="currentColor" stroke-linecap="round">
      <line class="clock__hand clock__hand--long" x1="24" y1="24" x2="24" y2="10.5" stroke-width="3"/>
      <g transform="rotate(120 24 24)">
        <line class="clock__hand clock__hand--short" x1="24" y1="24" x2="24" y2="16.5" stroke-width="3.5"/>
      </g>
    </g>
    <circle cx="24" cy="24" r="2.4" fill="currentColor"/>
  <% end %>
</svg>
