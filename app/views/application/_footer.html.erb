<%# Fixed to the bottom of every page except the test: who's playing (tap for settings), and stats %>
<% player = current_player %>
<footer class="site-footer">
  <%= link_to edit_profile_path, class: "site-footer__player" do %>
    <%= render "avatar", user: player, size: "small" %>
    <span><%= player.username || "Guest" %></span>
  <% end %>

  <% if player.guest? %>
    <span class="site-footer__auth">
      <%= link_to "Sign in", new_session_path %> · <%= link_to "Sign up", new_registration_path %>
    </span>
  <% end %>

  <%= link_to stats_path, class: "site-footer__stats" do %>
    <svg class="stats-icon" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="12" width="5" height="9" rx="1.5" fill="var(--yellow)"/>
      <rect x="9.5" y="7" width="5" height="14" rx="1.5" fill="var(--green)"/>
      <rect x="16" y="3" width="5" height="18" rx="1.5" fill="var(--blue)"/>
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="12" width="5" height="9" rx="1.5"/>
        <rect x="9.5" y="7" width="5" height="14" rx="1.5"/>
        <rect x="16" y="3" width="5" height="18" rx="1.5"/>
      </g>
    </svg>
    <span>Stats</span>
  <% end %>
</footer>
