<footer class="site-footer ui-navigation">
  <nav aria-label="Main navigation">
    <% primary_navigation.each do |label, symbol, path, active| %>
      <%= link_to path, class: "site-footer__tab site-footer__#{label.downcase}", aria: { current: ("page" if active) } do %>
        <%= icon(symbol, class: "footer-icon") %><span><%= label %></span>
      <% end %>
    <% end %>
  </nav>
</footer>
