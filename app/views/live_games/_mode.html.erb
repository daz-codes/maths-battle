<%# What's being played and which way it's won, updated for everyone in the lobby when the host changes them %>
<p id="live-mode" class="live-mode">
  <strong><%= topic_icon(live_game.topic_module) %> <%= live_game.title %></strong><br>
  <% if live_game.power? %>
    <%= icon(:gem) %> <strong>Power mode:</strong> the most gems wins, so speed and runs of right answers count
  <% else %>
    <%= icon(:check) %> <strong>Classic mode:</strong> the most right answers wins
  <% end %>
</p>
