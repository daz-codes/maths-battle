<% content_for :title, "Join #{@group.name} · MatheMinute" %>

<main class="page page--narrow">
  <h1 class="heading">Join <%= @group.name %>?</h1>
  <p class="aside">Run by <%= @group.owner.display_name %>. You'll play its challenges and see the leaderboards.</p>

  <%= form_with url: group_joins_path, class: "form" do %>
    <%= hidden_field_tag :code, @group.join_code %>
    <% if @user.name.blank? && @user.guest? %>
      <%= label_tag :name, "What should we call you?" %>
      <%= text_field_tag :name, nil, autocomplete: "given-name", maxlength: User::NAME_LENGTH, required: true %>
      <p class="hint">It's shown on the group's leaderboard. A first name is plenty.</p>
    <% end %>
    <%= submit_tag "Join the group", class: "button button--go", name: nil %>
  <% end %>
</main>
